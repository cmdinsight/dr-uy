# Copiá a .env.local para desarrollo. En Vercel se configuran como Environment Variables.

# Postgres (Vercel Postgres / Neon / Supabase). Requerida para todo el área /app.
DATABASE_URL="postgresql://usuario:password@host:5432/druy?sslmode=require"

# Secreto para firmar las sesiones (JWT). Poné una cadena larga y aleatoria.
AUTH_SECRET="cambiar-por-una-cadena-larga-y-aleatoria"

# Verificación de email (opcional). Sin esto, la app funciona pero no manda mails.
RESEND_API_KEY=""
EMAIL_FROM="DR.UY <no-responder@dr.uy>"
